// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String              @id
  name                String
  email               String
  studyPlans          StudyPlan[]
  favoritesStudyPlans FavoriteStudyPlan[]
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  role                String?
  banned              Boolean?            @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  quizAttempts        QuizAttempt[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @default("")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model StudyPlan {
  id                   String                @id @default(uuid())
  topic                String
  syllabus             String                @db.Text
  visibility           Visibility            @default(PRIVATE)
  status               Status                @default(PENDING)
  pdfUrl               String?
  threadId             String?
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos               VideoResource[]
  books                BookResource[]
  favorites            FavoriteStudyPlan[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deepLearningContents DeepLearningContent[]

  @@index([userId])
  @@index([visibility])
}

model VideoResource {
  id          String    @id @default(uuid())
  studyPlanId String
  title       String
  videoUrl    String
  videoId     String
  thumbnail   String?
  channelName String?
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studyPlanId])
}

model BookResource {
  id          String    @id @default(uuid())
  studyPlanId String
  title       String
  authors     String[]
  description String?
  infoLink    String?
  thumbnail   String?
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studyPlanId])
}

model FavoriteStudyPlan {
  id          String    @id @default(uuid())
  userId      String
  studyPlanId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, studyPlanId])
  @@index([userId])
  @@index([studyPlanId])
}

model DeepLearningContent {
  id           String         @id @default(uuid())
  studyPlanId  String
  title        String
  summary      String         @db.Text
  status       Status         @default(PENDING)
  topics       DeepTopic[]
  questions    QuizQuestion[]
  studyPlan    StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quizAttempts QuizAttempt[]

  @@index([studyPlanId])
}

model DeepTopic {
  id                    String              @id @default(uuid())
  slug                  String              @unique
  deepLearningContentId String              @unique
  title                 String
  description           String              @db.Text
  content               String              @db.Text
  order                 Int
  deepLearningContent   DeepLearningContent @relation(fields: [deepLearningContentId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([deepLearningContentId])
}

model QuizQuestion {
  id                    String              @id @default(uuid())
  deepLearningContentId String
  question              String
  options               String[]
  correctAnswer         String
  explanation           String
  order                 Int
  deepLearningContent   DeepLearningContent @relation(fields: [deepLearningContentId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id                    String              @id @default(uuid())
  userId                String
  deepLearningContentId String
  score                 Int
  total                 Int
  answers               Json
  deepLearningContent   DeepLearningContent @relation(fields: [deepLearningContentId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
